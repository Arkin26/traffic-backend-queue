# Copy is optional — run-traffic.sh uses these defaults for local PC runs.
HTTP_PORT=8080
TRAFFIC_API_IMAGE=traffic-lab/api:latest
TRAFFIC_LOADTEST_IMAGE=traffic-lab/loadtest:latest

# Optional: lock demo/loadtest UI (share key with teammates on same machine)
# DEMO_API_KEY=

# Tune if your laptop struggles during k6 (defaults are laptop-friendly)
LOADTEST_MAX_VUS=200
LOADTEST_MAX_QUEUE=2
LOADTEST_MAX_STEADY_SEC=90
