# Copy to deploy/.env and fill in before production deploy:
#   cp deploy/.env.example deploy/.env

# Public port for the Load Control Center UI + API
HTTP_PORT=8080

# Database (used by compose — do not commit deploy/.env)
POSTGRES_USER=traffic
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=traffic

# Auth secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
ADMIN_API_KEY=change-me-admin-key

# Optional: require this key for /v1/demo/* (share with testers only)
DEMO_API_KEY=change-me-demo-key

# Load test fairness caps (keeps API fast when many people test)
LOADTEST_MAX_VUS=150
LOADTEST_MAX_QUEUE=3
LOADTEST_MAX_CONCURRENT=1
LOADTEST_MAX_STEADY_SEC=90
LOADTEST_DEFAULT_VUS=80

# Connection pool (tune up on larger VMs)
DB_MAX_CONNS=40
DB_MIN_CONNS=5

DEMO_AUTO_SETUP=true
